# DeepGraph AI Environment Configuration
PROJECT_NAME="DeepGraph AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="super-secret-development-key-deepgraph-ai-2026"
JWT_SECRET="super-secret-jwt-key-deepgraph-ai-2026"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-deepgraph-ai-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL + pgvector with local SQLite fallback support)
DATABASE_URL="sqlite+aiosqlite:///./deepgraph.db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="deepgraph"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Redis Configuration (Job queue & cache with local in-memory fallback)
REDIS_URL="redis://localhost:6379/0"

# Neo4j Graph Database (with local in-memory graph engine fallback)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"

# LLM and Embedding Providers
LLM_PROVIDER="mock"  # Options: openai, anthropic, ollama, mock
EMBEDDING_PROVIDER="mock"  # Options: sentence_transformers, openai, mock
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# API Keys (Optional for live LLM providers)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# External APIs
ARXIV_API_URL="https://export.arxiv.org/api/query"

# Storage
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=50
